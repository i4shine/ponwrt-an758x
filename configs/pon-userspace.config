# ==============================================================================
# pon-userspace 上层应用清单（本仓库新增）
#
# 作用：让 build-firmware-manual.yml 出来的固件自带我们此前编译/验证过的
#      上层应用；让 build-packages-incremental.yml 生成同 ABI 的独立 apk。
# 源码位置：package/pon-userspace/<pkg>/（从 ufo1cn/PonWrt-HG5382A 整理迁移）
#
# 说明：
#   * tempinfo    —— LuCI 概览「温度」行 (/sbin/tempinfo)，纯脚本包
#   * camlive     —— UVC 摄像头 RTSP/HTTP MJPEG 推流后端（依赖 kmod-video-uvc）
#   * go2rtc      —— aarch64 静态二进制（1.9.15），无内核依赖
#   * gensio/ser2net —— USB 串口转网络（依赖 kmod-usb-serial*）
#   * luci-app-*  —— 上述后端与蓝牙音频/串口的 LuCI 前端
#
# NFS server 采用「内核内置」方案（见 target/linux/airoha/an7581/config-6.18 末尾
# 的 NFS_FS/NFSD/NFSD_V4/NFS_V4/LOCKD/SUNRPC/GRACE_PERIOD=y），因此这里只装
# 用户态 nfs-kernel-server，不再选择 kmod-fs-nfs* 系列（否则会得到空壳 kmod apk）。
# ==============================================================================

# ---- 自有应用 ----
CONFIG_PACKAGE_tempinfo=y
CONFIG_PACKAGE_camlive=y
CONFIG_PACKAGE_luci-app-camlive=y
CONFIG_PACKAGE_go2rtc=y
CONFIG_PACKAGE_luci-app-go2rtc=y
CONFIG_PACKAGE_gensio=y
CONFIG_PACKAGE_gensio-bin=y
CONFIG_PACKAGE_ser2net=y
CONFIG_PACKAGE_luci-app-ser2net=y
CONFIG_PACKAGE_luci-app-blueaudio=y
CONFIG_PACKAGE_luci-app-btsp=y

# ---- 蓝牙音频/串口前端依赖（feed 内包）----
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-libs=y
CONFIG_PACKAGE_bluez-alsa=y
CONFIG_PACKAGE_dbus=y

# ---- USB 主机/存储/串口（kmod，走同一内核树）----
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y

# ---- 摄像头（UVC）与音频 ----
CONFIG_PACKAGE_kmod-video-core=y
CONFIG_PACKAGE_kmod-video-videobuf2=y
CONFIG_PACKAGE_kmod-video-uvc=y
CONFIG_PACKAGE_audio-support=y
CONFIG_PACKAGE_kmod-input-core=y
CONFIG_PACKAGE_kmod-sound-core=y
CONFIG_PACKAGE_kmod-usb-audio=y
CONFIG_PACKAGE_alsa-utils=y

# ---- 蓝牙（kmod-bluetooth 提供 BT 核心，其余为 HCI 传输）----
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_kmod-btusb=y
CONFIG_PACKAGE_kmod-btbcm=y
CONFIG_PACKAGE_kmod-btmtk=y
CONFIG_PACKAGE_kmod-hci-uart=y

# ---- USB 无线网卡（HG5585F 侧常用，HG5382A 无 USB 时自动不生效）----
CONFIG_PACKAGE_kmod-rtw88=y
CONFIG_PACKAGE_kmod-rtw88-usb=y
CONFIG_PACKAGE_kmod-rtw88-8822cu=y
CONFIG_PACKAGE_kmod-rtw88-8821cu=y
CONFIG_PACKAGE_kmod-rtw88-8723du=y
CONFIG_PACKAGE_kmod-rtl8xxxu=y
CONFIG_PACKAGE_kmod-rtl8192cu=y
CONFIG_PACKAGE_linux-firmware-rtw88=y

# ---- 文件系统 / 共享 / NFS 用户态 ----
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_nfs-kernel-server-utils=y
CONFIG_PACKAGE_nfs-utils=y
CONFIG_PACKAGE_nfs-utils-libs=y

# ---- 诊断（zerotier/tailscale/honk 需要）----
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
